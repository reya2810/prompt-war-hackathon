@app.post("/auth/login", response_model=Token)
def login(login_data: UserLogin, db: Session = Depends(get_db)):
    u = db.query(User).filter(User.email == login_data.email).first()
    if not u or not verify_password(login_data.password, u.hashed_password):
        raise HTTPException(status_code=401, detail="Incorrect credentials")
    return {"access_token": create_access_token({"sub": u.email, "user_id": u.id, "role": u.role}), "token_type": "bearer", "user_id": u.id, "name": u.name, "email": u.email, "role": u.role}

