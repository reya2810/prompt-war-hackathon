class Orchestrator:
    def __init__(self):
        self.name = "Orchestrator"

    def _log_event(self, db: Session, user_id: int, event_type: str, input_desc: str, output_desc: str):
        event = AgentEvent(user_id=user_id, timestamp=datetime.utcnow(), event_type=event_type, agent_name=self.name, input_summary=input_desc, output_summary=output_desc)
        db.add(event)
        db.commit()

    def handle_event(self, event_name: str, db: Session, user: User, payload: Dict[str, Any] = None) -> Dict[str, Any]:
        payload = payload or {}
        results = {"event": event_name, "actions_taken": []}

        if event_name == "profile_created":
            self._log_event(db, user.id, "profile_created", f"New learner registered: {user.name} ({user.email}). Goal: {user.current_role_id}", "Triggering: ProfileAgent -> CareerAgent -> GapAnalyst -> CurriculumAgent -> MentorAgent")
            profile_agent.process_profile(db, user, resume_text=payload.get("resume_text"))
            career_agent.get_role_requirements(db, user.id, user.current_role_id)
            analysis = gap_analyst_agent.analyze_gaps(db, user, user.current_role_id)
            curriculum_agent.build_roadmap(db, user, user.current_role_id, analysis["missing_skills"], analysis["readiness_score"])
            welcome_msg = f"Welcome {user.name}! We analyzed your competencies against {analysis['role_name']}. Starting readiness: {analysis['readiness_score']}%. Your dependency-ordered roadmap is active!"
            db.add(ChatMessage(user_id=user.id, role="assistant", agent_name="MentorAgent", message=welcome_msg, timestamp=datetime.utcnow()))
            db.commit()
            results["actions_taken"] = ["profile_analyzed", "role_loaded", "gaps_computed", "roadmap_built", "mentor_welcomed"]

        elif event_name == "goal_changed":
            new_role_id = payload.get("new_role_id", user.current_role_id)
            user.current_role_id = new_role_id
            db.commit()
            self._log_event(db, user.id, "goal_changed", f"Goal switched to '{new_role_id}'", "Re-routing: CareerAgent -> GapAnalyst (reusing skills) -> CurriculumAgent -> MentorAgent")
            role_data = career_agent.get_role_requirements(db, user.id, new_role_id)
            analysis = gap_analyst_agent.analyze_gaps(db, user, new_role_id)
            curriculum_agent.build_roadmap(db, user, new_role_id, analysis["missing_skills"], analysis["readiness_score"])
            matched_names = [m["skill"] for m in analysis["matched_skills"]]
            reuse_note = f"Your existing strengths in {', '.join(matched_names[:3])} were reused!" if matched_names else ""
            msg = f"Goal changed to **{role_data['role_name']}**! Current readiness: **{analysis['readiness_score']}%**. {reuse_note}"
            db.add(ChatMessage(user_id=user.id, role="assistant", agent_name="MentorAgent", message=msg, timestamp=datetime.utcnow()))
            db.commit()
            results["actions_taken"] = ["career_reloaded", "gaps_recomputed", "roadmap_rebuilt", "mentor_explained"]
            results["analysis"] = analysis

        elif event_name == "assessment_submitted":
            skill_name = payload.get("skill_name")
            grade_res = assessment_agent.grade_assessment(db, user, skill_name, payload.get("answers", {}))
            score = grade_res["score"]
            weak_subs = grade_res["weak_subtopics"]

            if score < 60.0:
                self._log_event(db, user.id, "adaptive_rule_triggered", f"Score < 60% ({score}%) on '{skill_name}'. Weak: {weak_subs}", "CurriculumAgent: inserting remedial review module; MentorAgent: advice & study tip.")
                curriculum_agent.adapt_for_low_score(db, user, skill_name, score, weak_subs)
                msg = f"Iterative mastery is normal! Scored {score:.0f}% on {skill_name}. We inserted a remedial review on {', '.join(weak_subs) if weak_subs else 'fundamentals'} before you advance."
                db.add(ChatMessage(user_id=user.id, role="assistant", agent_name="MentorAgent", message=msg, timestamp=datetime.utcnow()))
                db.commit()
                results["actions_taken"] = ["graded", "remedial_inserted", "mentor_encouraged"]
                results["roadmap_updated"] = True
                results["explanation"] = f"Roadmap adapted: Inserted remedial review module '{skill_name} Fundamentals & Review' to reinforce weak areas."
            elif score <= 80.0:
                self._log_event(db, user.id, "adaptive_rule_triggered", f"Score {score}% on '{skill_name}'. Passing, but needs reinforcement.", "CurriculumAgent: keeping plan schedule; adding reinforcement mini-challenge.")
                results["actions_taken"] = ["graded", "reinforcement_attached"]
                results["roadmap_updated"] = False
                results["explanation"] = f"Solid work ({score}%). Core schedule maintained."
            else:
                self._log_event(db, user.id, "adaptive_rule_triggered", f"Score > 80% ({score}%) on '{skill_name}'. Advanced mastery.", "CurriculumAgent: marking milestone achieved, unlocking next topic & capstone project.")
                roadmap = db.query(Roadmap).filter(Roadmap.user_id == user.id).first()
                if roadmap:
                    item = db.query(RoadmapItem).filter(RoadmapItem.roadmap_id == roadmap.id, RoadmapItem.skill_name == skill_name).first()
                    if item:
                        item.status = "completed"
                        next_item = db.query(RoadmapItem).filter(RoadmapItem.roadmap_id == roadmap.id, RoadmapItem.order > item.order).order_by(RoadmapItem.order.asc()).first()
                        if next_item and next_item.status == "locked":
                            next_item.status = "in_progress"
                        db.commit()
                results["actions_taken"] = ["graded", "milestone_unlocked"]
                results["roadmap_updated"] = True
                results["explanation"] = f"Exceptional work ({score}%)! Milestone unlocked."

            analysis = gap_analyst_agent.analyze_gaps(db, user, user.current_role_id)
            roadmap = db.query(Roadmap).filter(Roadmap.user_id == user.id).first()
            if roadmap:
                roadmap.readiness_score = analysis["readiness_score"]
                db.commit()
            results["grade"] = grade_res

        elif event_name == "topic_completed":
            item_id = payload.get("item_id")
            item = db.query(RoadmapItem).filter(RoadmapItem.id == item_id).first()
            if item:
                item.status = "completed"
                next_item = db.query(RoadmapItem).filter(RoadmapItem.roadmap_id == item.roadmap_id, RoadmapItem.order > item.order).order_by(RoadmapItem.order.asc()).first()
                if next_item and next_item.status == "locked":
                    next_item.status = "in_progress"
                db.commit()
                analysis = gap_analyst_agent.analyze_gaps(db, user, user.current_role_id)
                roadmap = db.query(Roadmap).filter(Roadmap.id == item.roadmap_id).first()
                if roadmap:
                    roadmap.readiness_score = analysis["readiness_score"]
                    db.commit()
                self._log_event(db, user.id, "topic_completed", f"Learner finished: '{item.skill_name}'", f"Unlocked next topic. Readiness: {analysis['readiness_score']}%")
                results["actions_taken"] = ["topic_completed", "next_unlocked"]

        return results

