@app.post("/simulate", response_model=SimulationResponse)
def simulate_career(req: SimulationRequest, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
    role = db.query(JobRole).filter(JobRole.id == (req.role_id or user.current_role_id)).first() or db.query(JobRole).first()
    user_skills = {s.skill_name.lower(): s.level for s in db.query(UserSkill).filter(UserSkill.user_id == user.id).all()}
    reqs = role.required_skills or []
    tot_w = sum([r.get("weight", 3) for r in reqs])
    curr_w = sum([r.get("weight", 3) * min(user_skills.get(r["skill"].lower(), 0) / r.get("required_level", 80), 1.0) for r in reqs])
    curr_r = round(curr_w / tot_w * 100.0, 1) if tot_w > 0 else 0.0

    sim_skills = dict(user_skills)
    sim_skills[req.skill_to_add.lower()] = req.target_level
    sim_w = sum([r.get("weight", 3) * min(sim_skills.get(r["skill"].lower(), 0) / r.get("required_level", 80), 1.0) for r in reqs])
    proj_r = round(sim_w / tot_w * 100.0, 1) if tot_w > 0 else 0.0
    return {"skill_added": req.skill_to_add, "target_level": req.target_level, "current_readiness": curr_r, "projected_readiness": proj_r, "delta": round(proj_r - curr_r, 1), "impact_description": f"Mastering {req.skill_to_add} elevates readiness by +{round(proj_r - curr_r, 1)}%!"}

