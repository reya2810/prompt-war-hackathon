class CurriculumAgent(BaseAgent):
    def __init__(self):
        super().__init__(name="CurriculumAgent")

    def _topological_sort(self, skills_to_order: List[str], skill_prereqs_map: Dict[str, List[str]]) -> List[str]:
        in_degree = {s: 0 for s in skills_to_order}
        graph = defaultdict(list)
        skills_set = set(skills_to_order)

        for s in skills_to_order:
            for p in skill_prereqs_map.get(s, []):
                if p in skills_set:
                    graph[p].append(s)
                    in_degree[s] += 1

        queue = deque([s for s in skills_to_order if in_degree[s] == 0])
        ordered = []
        while queue:
            node = queue.popleft()
            ordered.append(node)
            for neighbor in graph[node]:
                in_degree[neighbor] -= 1
                if in_degree[neighbor] == 0:
                    queue.append(neighbor)

        for s in skills_to_order:
            if s not in ordered:
                ordered.append(s)
        return ordered

    def build_roadmap(self, db: Session, user: User, role_id: str, missing_skills: List[Dict[str, Any]], readiness_score: float) -> Roadmap:
        all_skills = {s.name: s for s in db.query(Skill).all()}
        skill_prereqs_map = {name: s.prerequisites or [] for name, s in all_skills.items()}
        skill_names = [m["skill"] for m in missing_skills] or ["Advanced System Design", "Production CI/CD Pipelines", "Capstone Project"]
        ordered_skills = self._topological_sort(skill_names, skill_prereqs_map)

        roadmap = db.query(Roadmap).filter(Roadmap.user_id == user.id).first()
        job_role = db.query(JobRole).filter(JobRole.id == role_id).first()
        role_name = job_role.name if job_role else "Target Role"

        if not roadmap:
            roadmap = Roadmap(user_id=user.id, target_role_id=role_id, role_name=role_name, total_weeks=max(len(ordered_skills), 4), readiness_score=readiness_score)
            db.add(roadmap)
            db.commit()
            db.refresh(roadmap)
        else:
            roadmap.target_role_id = role_id
            roadmap.role_name = role_name
            roadmap.readiness_score = readiness_score
            db.query(RoadmapItem).filter(RoadmapItem.roadmap_id == roadmap.id).delete()
            db.commit()

        pace_mult = max(1, round(10 / max(user.hours_per_week, 4)))
        items = []
        for idx, skill_name in enumerate(ordered_skills):
            week_num = (idx * pace_mult) + 1
            prereqs = skill_prereqs_map.get(skill_name, [])
            reason = f"Prerequisite for {', '.join(prereqs[:2])}" if prereqs else "Core requirement for role"
            res_list = [
                {"title": f"Mastering {skill_name}", "type": "docs", "url": f"https://developer.mozilla.org", "difficulty": "intermediate", "duration": "2 hours"},
                {"title": f"{skill_name} Video Walkthrough", "type": "video", "url": f"https://youtube.com", "difficulty": "beginner", "duration": "1.5 hours"},
                {"title": f"{skill_name} Interactive Drills", "type": "exercise", "url": f"https://exercism.org", "difficulty": "beginner", "duration": "3 hours"}
            ]
            task = {
                "title": f"Milestone Challenge: {skill_name}",
                "description": f"Build a functional micro-service verifying {skill_name} core syntax, edge cases, and asynchronous handling.",
                "starter_code": f"// Implement {skill_name} challenge
function init() { console.log('{skill_name} ready'); }
init();"
            }
            item = RoadmapItem(roadmap_id=roadmap.id, skill_name=skill_name, order=idx+1, week=week_num, status="in_progress" if idx == 0 else "locked", reason=reason, practice_task=task, resources=res_list)
            db.add(item)
            items.append(item)

        roadmap.total_weeks = items[-1].week if items else 12
        db.commit()

        input_desc = f"Building dependency roadmap for {len(ordered_skills)} skills with {user.hours_per_week}h/wk."
        output_desc = f"Generated {len(items)}-week topological path. Initial topic: '{ordered_skills[0] if ordered_skills else 'N/A'}'."
        self.log(db, user.id, "roadmap_generated", input_desc, output_desc)
        return roadmap

    def adapt_for_low_score(self, db: Session, user: User, skill_name: str, score: float, weak_subtopics: List[str]):
        roadmap = db.query(Roadmap).filter(Roadmap.user_id == user.id).first()
        if not roadmap:
            return
        remedial_title = f"{skill_name} Fundamentals & Review"
        if not db.query(RoadmapItem).filter(RoadmapItem.roadmap_id == roadmap.id, RoadmapItem.skill_name == remedial_title).first():
            target_item = db.query(RoadmapItem).filter(RoadmapItem.roadmap_id == roadmap.id, RoadmapItem.skill_name == skill_name).first()
            insert_order = target_item.order if target_item else 1
            insert_week = target_item.week if target_item else 1

            for s in db.query(RoadmapItem).filter(RoadmapItem.roadmap_id == roadmap.id, RoadmapItem.order >= insert_order).all():
                s.order += 1
                s.week += 1

            weak_text = f" ({', '.join(weak_subtopics)})" if weak_subtopics else ""
            remedial_item = RoadmapItem(
                roadmap_id=roadmap.id,
                skill_name=remedial_title,
                order=insert_order,
                week=insert_week,
                status="in_progress",
                reason=f"Inserted remedial topic: Low quiz score ({score:.0f}%){weak_text}",
                practice_task={"title": f"Remedial Drills: {skill_name}", "description": f"Remediation on {', '.join(weak_subtopics) if weak_subtopics else 'fundamentals'}."},
                resources=[{"title": f"{skill_name} Review Tutorial", "type": "video", "url": "https://youtube.com", "difficulty": "beginner", "duration": "45m"}]
            )
            db.add(remedial_item)
            roadmap.total_weeks += 1
            db.commit()
            self.log(db, user.id, "curriculum_remedial_inserted", f"Score {score}% on {skill_name}. Weak: {weak_subtopics}", f"Inserted '{remedial_title}' at week {insert_week}.")

curriculum_agent = CurriculumAgent()

class AssessmentAgent(BaseAgent):
    def __init__(self):
        super().__init__(name="AssessmentAgent")

    def grade_assessment(self, db: Session, user: User, skill_name: str, answers: Dict[str, int]) -> Dict[str, Any]:
        assessment = db.query(Assessment).filter(Assessment.skill_name.ilike(skill_name)).first()
        questions = assessment.questions if assessment else [
            {"id": 1, "question": f"What is the best practice for architecture in {skill_name}?", "options": ["Tight coupling", "Modular separation of concerns", "Ignore errors", "Hardcoding"], "correct_answer": 1, "subtopic": "Architecture"},
            {"id": 2, "question": f"How are async operations handled in {skill_name}?", "options": ["Blocking thread", "Promises / async-await", "Infinite busy loop", "Process kill"], "correct_answer": 1, "subtopic": "Concurrency"}
        ]

        total = len(questions)
        correct = 0
        weak_set = set()
        for q in questions:
            user_ans = answers.get(str(q["id"]))
            if user_ans is not None and int(user_ans) == int(q.get("correct_answer", 0)):
                correct += 1
            else:
                weak_set.add(q.get("subtopic", "Core"))

        score = round((correct / total * 100.0) if total > 0 else 0.0, 1)
        weak_list = list(weak_set)
        passed = score >= 60.0

        feedback = f"Outstanding! ({score}%)" if score >= 80 else (f"Good effort ({score}%). Reinforce {', '.join(weak_list)}." if score >= 60 else f"Needs remediation ({score}%). Gaps in {', '.join(weak_list)}.")

        db.add(Attempt(user_id=user.id, assessment_id=assessment.id if assessment else None, skill_name=skill_name, score=score, weak_subtopics=weak_list, feedback=feedback, answers=answers))
        
        user_skill = db.query(UserSkill).filter(UserSkill.user_id == user.id, UserSkill.skill_name == skill_name).first()
        if user_skill:
            user_skill.level = int(score)
            user_skill.evidence = f"Scored {score:.0f}% on assessment. Weak subtopics: {', '.join(weak_list) if weak_list else 'none'}."
            user_skill.source = "quiz"
        else:
            db.add(UserSkill(user_id=user.id, skill_name=skill_name, level=int(score), evidence=f"Scored {score:.0f}% on quiz.", source="quiz"))
        db.commit()

        self.log(db, user.id, "assessment_graded", f"Grading '{skill_name}': {len(answers)} submitted.", f"Score: {score}% ({'PASSED' if passed else 'FAILED'}). Weak: {weak_list}.")
        return {"skill_name": skill_name, "score": score, "passed": passed, "weak_subtopics": weak_list, "feedback": feedback}

